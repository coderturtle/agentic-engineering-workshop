---
import { getCollection } from "astro:content";
import BaseLayout from "../components/layout/BaseLayout.astro";

const entries = (await getCollection("buildlog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Terminal Velocity: build log"
  description="Learn agentic engineering by running it in a harness, not reading about it."
>
  <h1 class="text-3xl font-bold">Terminal Velocity</h1>
  <p class="mt-2 text-lg opacity-80">
    Learn agentic engineering by running it in a harness, not reading about it. This is the
    build-in-public journal: the workshop itself lives in the repo.
  </p>

  <h2 class="mt-10 text-xl font-semibold">Build log</h2>
  <ul class="mt-6 space-y-4">
    {
      entries.map((entry) => (
        <li>
          <a href={`${base}build-log/${entry.id}/`} class="text-xl font-semibold underline">
            {entry.data.title}
          </a>
          <p class="text-sm opacity-80">{entry.data.description}</p>
        </li>
      ))
    }
  </ul>
  <p class="mt-8 text-sm opacity-70">
    See the <a href={`${base}build-log/`} class="underline">full index</a>.
  </p>
</BaseLayout>
