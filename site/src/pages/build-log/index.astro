---
import { getCollection } from "astro:content";
import BaseLayout from "../../components/layout/BaseLayout.astro";

const entries = (await getCollection("buildlog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "numeric" });

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Build log index" description="Every dated entry in the Terminal Velocity build log.">
  <h1 class="text-3xl font-bold">Build log</h1>
  <ul class="mt-6 space-y-6">
    {
      entries.map((entry) => (
        <li>
          <p class="font-mono text-xs uppercase tracking-widest opacity-60">
            {fmt(entry.data.pubDate)}
          </p>
          <a href={`${base}build-log/${entry.id}/`} class="text-xl font-semibold underline">
            {entry.data.title}
          </a>
          <p class="text-sm opacity-80">{entry.data.description}</p>
        </li>
      ))
    }
  </ul>
</BaseLayout>
