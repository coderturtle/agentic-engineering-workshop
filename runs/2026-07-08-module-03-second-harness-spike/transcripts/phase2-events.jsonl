{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/bin/zsh -lc \"nl -ba receipts/grouping.py | sed -n '1,170p'\"","aggregated_output":"     1\t\"\"\"Group expense receipts by calendar month.\n     2\t\n     3\tFull spec: fixtures/receipts/SPEC.md. Summary:\n     4\t\n     5\t    group_expenses_by_month(rows, tz) -> GroupResult\n     6\t\n     7\t    rows: an iterable of raw CSV-row dicts with keys\n     8\t        receipt_id, timestamp_utc, amount, category, note\n     9\t    tz: an IANA timezone name (e.g. \"America/New_York\"). Grouping happens\n    10\t        on the calendar month in this timezone, not in UTC.\n    11\t\n    12\t    Returns a GroupResult with:\n    13\t        months: dict[str, MonthSummary] keyed \"YYYY-MM\" in `tz`\n    14\t        errors: list[RowError] for rows that could not be parsed\n    15\t\n    16\t    Required edge cases:\n    17\t        1. empty input -> months == {}, errors == []\n    18\t        2. a receipt whose UTC timestamp crosses a month boundary once\n    19\t           converted to `tz` groups into the local month, not the UTC one\n    20\t        3. duplicate timestamps are independent receipts, never merged\n    21\t        4. a malformed row (bad timestamp or non-numeric amount) is\n    22\t           collected in `errors`, excluded from `months`, and does not\n    23\t           stop the remaining rows from being processed\n    24\t\"\"\"\n    25\t\n    26\tfrom __future__ import annotations\n    27\t\n    28\tfrom collections import defaultdict\n    29\tfrom dataclasses import dataclass, field\n    30\tfrom datetime import datetime\n    31\t\n    32\t\n    33\t@dataclass\n    34\tclass RowError:\n    35\t    row: dict\n    36\t    reason: str\n    37\t\n    38\t\n    39\t@dataclass\n    40\tclass MonthSummary:\n    41\t    total: float = 0.0\n    42\t    count: int = 0\n    43\t    receipt_ids: list = field(default_factory=list)\n    44\t\n    45\t\n    46\t@dataclass\n    47\tclass GroupResult:\n    48\t    months: dict\n    49\t    errors: list\n    50\t\n    51\t\n    52\tdef _parse_row(row: dict):\n    53\t    receipt_id = row.get(\"receipt_id\", \"\")\n    54\t    ts_raw = row.get(\"timestamp_utc\", \"\")\n    55\t    amount_raw = row.get(\"amount\", \"\")\n    56\t\n    57\t    try:\n    58\t        ts = datetime.fromisoformat(str(ts_raw).replace(\"Z\", \"+00:00\"))\n    59\t    except (ValueError, AttributeError):\n    60\t        return None, RowError(row=row, reason=f\"unparseable timestamp: {ts_raw!r}\")\n    61\t\n    62\t    try:\n    63\t        amount = float(amount_raw)\n    64\t    except (ValueError, TypeError):\n    65\t        return None, RowError(row=row, reason=f\"unparseable amount: {amount_raw!r}\")\n    66\t\n    67\t    return (receipt_id, ts, amount), None\n    68\t\n    69\t\n    70\tdef group_expenses_by_month(rows, tz: str) -> GroupResult:\n    71\t    months: dict[str, MonthSummary] = defaultdict(MonthSummary)\n    72\t    errors: list[RowError] = []\n    73\t\n    74\t    for row in rows:\n    75\t        parsed, err = _parse_row(row)\n    76\t        if err is not None:\n    77\t            errors.append(err)\n    78\t            continue\n    79\t        receipt_id, ts, amount = parsed\n    80\t        key = ts.strftime(\"%Y-%m\")\n    81\t\n    82\t        summary = months[key]\n    83\t        summary.total += amount\n    84\t        summary.count += 1\n    85\t        summary.receipt_ids.append(receipt_id)\n    86\t\n    87\t    return GroupResult(months=dict(months), errors=errors)\n    88\t\n    89\t\n    90\tdef group_expenses_by_category(rows) -> GroupResult:\n    91\t    \"\"\"Group parsed receipt rows by category.\n    92\t\n    93\t    Same shape as group_expenses_by_month, keyed by `category` instead of\n    94\t    calendar month (the `months` field on GroupResult is reused as a\n    95\t    generic bucket-by-key dict; the name is a little off for this case,\n    96\t    left as-is rather than renamed to avoid touching group_expenses_by_month's\n    97\t    callers). Reuse `_parse_row` the same way group_expenses_by_month does.\n    98\t    \"\"\"\n    99\t    categories: dict[str, MonthSummary] = defaultdict(MonthSummary)\n   100\t    errors: list[RowError] = []\n   101\t\n   102\t    for row in rows:\n   103\t        parsed, err = _parse_row(row)\n   104\t        if err is not None:\n   105\t            errors.append(err)\n   106\t            continue\n   107\t        receipt_id, _ts, amount = parsed\n   108\t        key = row.get(\"category\", \"\")\n   109\t\n   110\t        summary = categories[key]\n   111\t        summary.total += amount\n   112\t        summary.count += 1\n   113\t        summary.receipt_ids.append(receipt_id)\n   114\t\n   115\t    return GroupResult(months=dict(categories), errors=errors)\n","exit_code":0,"status":"completed"}}
