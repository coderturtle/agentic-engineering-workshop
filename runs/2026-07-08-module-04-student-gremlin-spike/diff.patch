+def _localize_utc_to_tz(ts: datetime, tz_str: str) -> datetime:
+    """Convert a UTC datetime to the target timezone."""
+    if ZoneInfo is None:
+        # Fallback for older Python versions
+        import pytz
+        tz = pytz.timezone(tz_str)
+        return ts.astimezone(tz)
+    else:
+        tz = ZoneInfo(tz_str)
+        return ts.astimezone(tz)
